# Copie para .env e preencha.

# Senha do Postgres usada pelo docker-compose.
POSTGRES_PASSWORD=troque-esta-senha

# Chave que criptografa senhas e tokens das conexões (32 bytes em hex).
# Gere com: openssl rand -hex 32
# Guarde em lugar seguro: sem ela as conexões salvas não podem ser lidas.
ENCRYPTION_KEY=

# Primeiro administrador, criado só quando o banco está vazio.
ADMIN_EMAIL=admin@empresa.com.br
ADMIN_PASSWORD=troque-no-primeiro-acesso

# Opcionais
# PORT=3000
# SESSION_TTL_HOURS=12
# Dias que as execuções ficam guardadas; 0 guarda para sempre.
# EXECUTION_RETENTION_DAYS=0
# Guarda entrada e saída de cada nó também nas execuções agendadas com sucesso (ocupa mais espaço).
# KEEP_SUCCESS_DATA=false
# WORKER_CONCURRENCY=5
# Use false para rodar o worker separado (npm run start:worker -w @sa/server).
# RUN_WORKER_IN_PROCESS=true
# Use true quando a aplicação estiver atrás de HTTPS.
# SECURE_COOKIES=false
