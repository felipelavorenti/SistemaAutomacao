{
  "name": "@sa/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker-main.ts",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker-main.js",
    "test": "vitest run",
    "docs:api": "tsx scripts/update-api-doc.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/static": "^8.0.0",
    "@sa/engine": "0.1.0",
    "bcryptjs": "^3.0.0",
    "bullmq": "^5.30.0",
    "cron-parser": "^5.0.0",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.0",
    "pg": "^8.13.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
